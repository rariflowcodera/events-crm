# ===========================================
# Events CRM - Environment Variables
# ===========================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/events_crm
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# SMTP Email (use Mailpit for local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@events-crm.local

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Better Auth
BETTER_AUTH_URL=http://localhost:3000

# Storage Provider: "local" or "s3"
STORAGE_PROVIDER=local

# AWS S3 (Bahrain region for KSA compliance) - only needed if STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-south-1
S3_UPLOAD_BUCKET=

# Stripe (optional)
STRIPE_STARTER_PRICE_ID_MONTHLY=
STRIPE_STARTER_PRICE_ID_YEARLY=
STRIPE_PRO_PRICE_ID_MONTHLY=
STRIPE_PRO_PRICE_ID_YEARLY=

# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OCI Email Delivery (for suppression list sync)
# Get these from OCI Console: Identity & Security > Users > API Keys
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY=
OCI_REGION=me-jeddah-1
OCI_COMPARTMENT_ID=

# Seed Script
# Set this to create an initial admin user and demo workspace when running `npm run db:seed`
SEED_ADMIN_EMAIL=rahan.arif@genaiera.com
