{
  "name": "next-js-15-sass-template",
  "version": "1.0.25",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:start": "docker-compose up -d && npm run dev",
    "dev:setup": "docker-compose up -d && npm run db:push && npm run db:seed && npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "dotenv -e .env.local -- tsx server/db/seed.ts",
    "db:setup": "dotenv -e .env.local -- drizzle-kit migrate && npm run db:seed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:drop": "drizzle-kit drop",
    "db:studio": "drizzle-kit studio",
    "check:unused": "depcheck",
    "check:files": "ts-prune",
    "format": "prettier --check --ignore-path .gitignore .",
    "format:fix": "prettier --write --ignore-path .gitignore .",
    "worker:email": "dotenv -e .env.local -- tsx --watch server/workers/email-worker.ts",
    "worker:email:prod": "dotenv -e .env.local -- node --import tsx server/workers/email-worker.ts",
    "worker:suppression": "dotenv -e .env.local -- tsx --watch server/workers/suppression-sync-worker.ts",
    "worker:suppression:prod": "dotenv -e .env.local -- node --import tsx server/workers/suppression-sync-worker.ts",
    "bump:major": "node scripts/bump-version.mjs major",
    "bump:minor": "node scripts/bump-version.mjs minor",
    "bump:patch": "node scripts/bump-version.mjs patch",
    "deploy": "node scripts/deploy.mjs"
  },
